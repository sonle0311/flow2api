{
  "manifest_version": 3,
  "name": "Flow2API - Trình xử lý mã xác minh",
  "version": "1.0.0",
  "description": "Tạo mã xác minh reCAPTCHA Enterprise của Google Labs cho Flow2API.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
